# Hidden files/directories (except .polarion-root, .gitignore, .env.example)
.*
!.polarion-root
!.gitignore
!.env.example

# Logs
**/logs/
*.log

# commit-msg hook output
err_commit_msg.txt

# Official template checklists, fetched live each run (never committed)
.cache/

# Generated review reports
projects/*/out/

# Editor/IDE
*.swp
*.swo
*~
*.bak
*.tmp
*.orig

# OS
.DS_Store
Thumbs.db

# Runtime
__pycache__/
*.pyc

# Localized review outputs
skills/*/out/
